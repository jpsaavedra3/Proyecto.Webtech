<% content_for :title, "Sign up" %>

<section class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
      <h1 class="mb-4">Create your account</h1>

      <%= form_with model: @user, url: registration_path do |form| %>
        <div class="mb-3">
          <%= form.label :name, class: "form-label" %>
          <%= form.text_field :name, required: true, autofocus: true, class: field_class(@user, :name) %>
          <%= field_error(@user, :name) %>
        </div>
        <div class="mb-3">
          <%= form.label :email_address, class: "form-label" %>
          <%= form.email_field :email_address, required: true, autocomplete: "username",
                               class: field_class(@user, :email_address) %>
          <%= field_error(@user, :email_address) %>
        </div>
        <div class="mb-3">
          <%= form.label :password, class: "form-label" %>
          <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72,
                                  class: field_class(@user, :password) %>
          <%= field_error(@user, :password) %>
        </div>
        <div class="mb-3">
          <%= form.label :password_confirmation, "Repeat the password", class: "form-label" %>
          <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72,
                                  class: field_class(@user, :password_confirmation) %>
          <%= field_error(@user, :password_confirmation) %>
        </div>
        <%= form.submit "Sign up", class: "btn btn-primary w-100" %>
      <% end %>

      <p class="mt-3">Already have an account? <%= link_to "Sign in", new_session_path %></p>
    </div>
  </div>
</section>