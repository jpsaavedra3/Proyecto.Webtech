<% content_for :title, "Properties" %>

<section class="container py-5">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Properties</h1>
    <%= link_to "New property", new_property_path, class: "btn btn-primary" %>
  </div>

  <% if @properties.empty? %>
    <p class="text-muted">There are no properties yet.</p>
  <% else %>
    <table class="table table-striped table-hover">
      <thead>
      <tr>
        <th>Address</th>
        <th>Neighborhood</th>
        <th>Type</th>
        <th>Bedrooms</th>
        <th>Listings</th>
      </tr>
      </thead>
      <tbody>
      <%= render @properties %>
      </tbody>
    </table>
  <% end %>
</section>