<% content_for :title, "Applications" %>

<section class="container py-5">
  <h1>Applications</h1>
  <p class="text-muted"><%= pluralize(@pending_count, "application") %> waiting for an answer.</p>

  <% if @applications.empty? %>
    <p class="text-muted">There are no applications yet.</p>
  <% else %>
    <table class="table table-striped table-hover">
      <thead>
      <tr>
        <th>Applicant</th>
        <th>Room</th>
        <th>Move-in date</th>
        <th>Status</th>
      </tr>
      </thead>
      <tbody>
      <%= render @applications %>
      </tbody>
    </table>
  <% end %>
</section>