<% content_for :title, @neighborhood.name %>

<section class="container py-5">
  <h1><%= @neighborhood.name %></h1>

  <h2 class="h4 mt-4">Available rooms</h2>
  <% if @listings.empty? %>
    <p class="text-muted">No rooms are published in this neighborhood right now.</p>
  <% else %>
    <div class="row g-4">
      <%= render @listings %>
    </div>
  <% end %>

  <%= link_to "All neighborhoods", neighborhoods_path, class: "btn btn-outline-secondary mt-3" %>
</section>