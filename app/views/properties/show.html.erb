<% content_for :title, @property.address %>

<section class="container py-5">
  <h1><%= @property.address %></h1>
  <p class="lead">
    <%= link_to @property.neighborhood.name, @property.neighborhood %> ·
    <%= @property.property_type.humanize %> ·
    <%= pluralize(@property.bedrooms, "bedroom") %> ·
    <%= pluralize(@property.bathrooms, "bathroom") %>
  </p>
  <% if @property.shared_spaces.present? %>
    <p>Shared spaces: <%= @property.shared_spaces %></p>
  <% end %>
  <p class="text-muted">Host: <%= @property.user.name %></p>

  <div class="d-flex gap-2 mb-4">
    <%= link_to "Add a room", new_property_listing_path(@property), class: "btn btn-primary" %>
    <%= link_to "Edit", edit_property_path(@property), class: "btn btn-outline-secondary" %>
    <%= button_to "Delete", @property, method: :delete, class: "btn btn-outline-danger",
                  form: { data: { turbo_confirm: "Delete this property?" } } %>
  </div>

  <h2 class="h4">Amenities</h2>
  <% if @property.amenities.empty? %>
    <p class="text-muted">This property has no amenities listed.</p>
  <% else %>
    <ul class="list-inline">
      <% @property.amenities.each do |amenity| %>
        <li class="list-inline-item badge text-bg-light border"><%= amenity.name %></li>
      <% end %>
    </ul>
  <% end %>

  <h2 class="h4 mt-4">Rooms in this property</h2>
  <% if @property.user == current_user %>
    <p class="text-muted small">You are the host, so you also see the rooms that are not published.</p>
  <% end %>
  <% if @listings.empty? %>
    <p class="text-muted">No rooms are published right now.</p>
  <% else %>
    <div class="row g-4">
      <%= render @listings %>
    </div>
  <% end %>

  <h2 class="h4 mt-4">Reviews</h2>
  <% if @property.reviews.empty? %>
    <p class="text-muted">Nobody has reviewed this property yet.</p>
  <% else %>
    <%= render @property.reviews %>
  <% end %>
  <%= render "reviews/new_review", property: @property, visit: @reviewable_visit %>

  <%= link_to "All properties", properties_path, class: "btn btn-outline-secondary mt-3" %>
</section>