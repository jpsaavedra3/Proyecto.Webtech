<%= form_with model: neighborhood do |f| %>
  <div class="mb-3">
    <%= f.label :name, "Neighborhood name", class: "form-label" %>
    <%= f.text_field :name,
          class: field_class(neighborhood, :name),
          placeholder: "e.g. Providencia",
          required: true %>
    <%= field_error(neighborhood, :name) %>
  </div>

  <div class="d-flex gap-2">
    <%= f.submit "Save neighborhood", class: "btn btn-primary" %>
    <%= link_to "Cancel", neighborhoods_path,
          class: "btn btn-outline-secondary" %>
  </div>
<% end %>