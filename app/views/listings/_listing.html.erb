<div class="col-md-4">
  <article class="card h-100">
    <% if listing.photos.attached? %>
      <%= image_tag listing.photos.first.variant(resize_to_fill: [ 600, 400 ]), class: "card-img-top",
                    alt: "Room in #{listing.property.neighborhood.name}" %>
    <% end %>
    <div class="card-body">
      <% unless listing.published? %>
        <span class="badge text-bg-secondary mb-2"><%= listing.status.humanize %></span>
      <% end %>
      <h3 class="card-title h5"><%= link_to listing.property.neighborhood.name, listing %></h3>
      <p class="card-text mb-1"><%= number_to_currency(listing.monthly_rent, unit: "$", precision: 0, delimiter: ".") %> per month</p>
      <p class="card-text text-muted mb-1">Available from <%= l(listing.available_from, format: :long) %></p>
      <p class="card-text small mb-0"><%= listing.property.address %></p>
    </div>
  </article>
</div>