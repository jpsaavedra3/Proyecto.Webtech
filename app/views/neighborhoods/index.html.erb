
<% content_for :title, "Neighborhoods" %>

<section class="container py-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Neighborhoods</h1>

    <%= link_to "New Neighborhood", new_neighborhood_path,
          class: "btn btn-primary" %>
  </div>

  <% if @neighborhoods.empty? %>
    <p class="text-muted">There are no neighborhoods yet.</p>
  <% else %>
    <ul class="list-group">
      <% @neighborhoods.each do |neighborhood| %>
        <li class="list-group-item d-flex justify-content-between align-items-center">

          <div>
            <%= link_to neighborhood.name, neighborhood %>
            <span class="text-muted ms-2">
              <%= pluralize(neighborhood.properties.size, "property") %>
            </span>
          </div>

          <div class="d-flex gap-2">
            <%= link_to "Edit", edit_neighborhood_path(neighborhood),
                  class: "btn btn-sm btn-outline-primary" %>

            <%= button_to "Delete", neighborhood_path(neighborhood),
                  method: :delete,
                  class: "btn btn-sm btn-outline-danger",
                  form: {
                    data: {
                      turbo_confirm: "Are you sure you want to delete this neighborhood?"
                    }
                  } %>
          </div>

        </li>
      <% end %>
    </ul>
  <% end %>
</section>
