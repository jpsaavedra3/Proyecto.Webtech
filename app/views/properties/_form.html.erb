<%= form_with model: property do |f| %>
  <div class="mb-3">
    <%= f.label :address, class: "form-label" %>
    <%= f.text_field :address, class: field_class(property, :address), placeholder: "Av. Manuel Montt 1234", required: true %>
    <%= field_error(property, :address) %>
  </div>

  <div class="row g-3 mb-3">
    <div class="col-md-6">
      <%= f.label :neighborhood_id, "Neighborhood", class: "form-label" %>
      <%= f.collection_select :neighborhood_id, Neighborhood.order(:name), :id, :name, { prompt: "Choose a neighborhood" },
                              class: field_class(property, :neighborhood, "form-select"), required: true %>
      <%= field_error(property, :neighborhood) %>
    </div>
    <div class="col-md-6">
      <%= f.label :property_type, class: "form-label" %>
      <%= f.select :property_type, Property::TYPES.map { |type| [ type.humanize, type ] }, { prompt: "Choose a type" },
                   class: field_class(property, :property_type, "form-select"), required: true %>
      <%= field_error(property, :property_type) %>
    </div>
  </div>

  <div class="row g-3 mb-3">
    <div class="col-md-6">
      <%= f.label :bedrooms, class: "form-label" %>
      <%= f.number_field :bedrooms, class: field_class(property, :bedrooms), min: 1, placeholder: "3", required: true %>
      <%= field_error(property, :bedrooms) %>
    </div>
    <div class="col-md-6">
      <%= f.label :bathrooms, class: "form-label" %>
      <%= f.number_field :bathrooms, class: field_class(property, :bathrooms), min: 1, placeholder: "2", required: true %>
      <%= field_error(property, :bathrooms) %>
    </div>
  </div>

  <div class="mb-3">
    <%= f.label :shared_spaces, class: "form-label" %>
    <%= f.textarea :shared_spaces, class: field_class(property, :shared_spaces), rows: 2,
                   placeholder: "Living room, kitchen and balcony" %>
  </div>

  <fieldset class="mb-3">
    <legend class="form-label fs-6">Amenities</legend>
    <%= f.collection_check_boxes :amenity_ids, Amenity.order(:name), :id, :name do |b| %>
      <div class="form-check form-check-inline">
        <%= b.check_box class: "form-check-input" %>
        <%= b.label class: "form-check-label" %>
      </div>
    <% end %>
  </fieldset>

  <%= f.submit class: "btn btn-primary" %>
<% end %>