<!DOCTYPE html>
<html lang="en">
<head>
  <title><%= content_for(:title) || "Roomies" %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <%= yield :head %>

  <link rel="icon" href="/icon.png" type="image/png">
  <link rel="icon" href="/icon.svg" type="image/svg+xml">

  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag "actiontext", "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
</head>

<body>
<header>
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
      <%= link_to "Roomies", root_path, class: "navbar-brand" %>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu"
              aria-controls="menu" aria-expanded="false" aria-label="Open the menu">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="menu">
        <ul class="navbar-nav ms-auto align-items-lg-center">
          <li class="nav-item"><%= link_to "Rooms", listings_path, class: "nav-link" %></li>
          <li class="nav-item"><%= link_to "Properties", properties_path, class: "nav-link" %></li>
          <li class="nav-item"><%= link_to "Neighborhoods", neighborhoods_path, class: "nav-link" %></li>
          <% if current_user %>
            <li class="nav-item"><%= link_to "Applications", applications_path, class: "nav-link" %></li>
            <% if current_user.moderator? %>
              <li class="nav-item"><%= link_to "Amenities", amenities_path, class: "nav-link" %></li>
              <li class="nav-item"><%= link_to "Reports", reports_path, class: "nav-link" %></li>
            <% end %>
            <li class="nav-item"><%= link_to current_user.name, edit_profile_path, class: "nav-link" %></li>
            <li class="nav-item">
              <%= button_to "Sign out", session_path, method: :delete, class: "btn btn-link nav-link" %>
            </li>
          <% else %>
            <li class="nav-item"><%= link_to "Sign in", new_session_path, class: "nav-link" %></li>
            <li class="nav-item"><%= link_to "Sign up", new_registration_path, class: "btn btn-primary btn-sm ms-lg-2" %></li>
          <% end %>
        </ul>
      </div>
    </div>
  </nav>
</header>

<main>
  <% flash.each do |type, message| %>
    <div class="container mt-3">
      <div class="alert <%= type == "notice" ? "alert-success" : "alert-danger" %>" role="alert"><%= message %></div>
    </div>
  <% end %>

  <%= yield %>
</main>

<footer class="bg-dark text-white py-4">
  <div class="container text-center">
    <p class="mb-1">Roomies — Juan Pablo Saavedra and Julian Rodriguez</p>
    <p class="mb-0">Web Technologies (ICC4130) · Universidad de los Andes · 2026</p>
  </div>
</footer>
</body>
</html>