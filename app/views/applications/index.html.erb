<% content_for :title, "Applications" %>

<section class="container py-5">
  <h1>Applications</h1>

  <h2 class="h4 mt-4">Received on my rooms</h2>
  <p class="text-muted"><span id="pending_count"><%= pluralize(@pending_count, "application") %></span> waiting for an answer.</p>
  <% if @received.empty? %>
    <p class="text-muted">Nobody has applied to your rooms yet.</p>
  <% else %>
    <table class="table table-hover align-middle">
      <thead>
      <tr>
        <th>Applicant</th>
        <th>Room</th>
        <th>Move-in date</th>
        <th>Status</th>
        <th>Answer</th>
      </tr>
      </thead>
      <tbody>
      <%= render partial: "inbox_row", collection: @received, as: :application %>
      </tbody>
    </table>
  <% end %>

  <h2 class="h4 mt-5">Sent by me</h2>
  <% if @sent.empty? %>
    <p class="text-muted">You have not applied to any room.</p>
  <% else %>
    <table class="table table-striped table-hover">
      <thead>
      <tr>
        <th>Applicant</th>
        <th>Room</th>
        <th>Move-in date</th>
        <th>Status</th>
      </tr>
      </thead>
      <tbody>
      <%= render @sent %>
      </tbody>
    </table>
  <% end %>
</section>